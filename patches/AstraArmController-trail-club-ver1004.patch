+// 初期化中の異常時: 予圧を止めて ID4-11 を脱力し、config を書かずに戻る。
+// (元は while(1) でタイマタスクを止め、WDT リセットまで PWM が出続けていた)
+static void abortInit() {
+  for (int i = 0; i < 4 * JOINT_NUM; ++i) {
+    sts.writeWord(4 + i, SCSCL_GOAL_TIME_L, 0);
+    sts.EnableTorque(4 + i, 0);
+  }
+  // RAM 上の init_pos は途中まで書き換わっている可能性があるので、
+  // 再起動 (/config.txt から再読込) か再初期化まで制御ループを止める
+  torque_enabled = false;
+  config.init_pos_inited = false;
+  Serial.println("INIT ABORTED: config not written. Reboot or re-run init.");
+}
+
 void doSetupTorque(int enable) {
