+        self.side = side
+        profile = self.ARM_PROFILES.get(side)
+        if profile is None:
+            logger.warning(f"side={side!r}: 腕ごとの符号・可動域を使わない (upstream 既定のまま)")
+            self.joint_sign = np.ones(6)
+            self.joint_min = self.JOINT_MIN
+            self.joint_max = self.JOINT_MAX
