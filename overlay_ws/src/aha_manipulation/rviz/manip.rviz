Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 10
      Color: 160; 160; 164
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Marker Scale: 0.15
    # Current robot (Scene Robot), draggable goal (Planning Request),
    # planned path animation (Planned Path) and the MotionPlanning panel.
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      MoveIt_Allow_Approximate_IK: false
      MoveIt_Allow_External_Program: false
      MoveIt_Allow_Replanning: false
      MoveIt_Allow_Sensor_Positioning: false
      MoveIt_Planning_Attempts: 10
      MoveIt_Planning_Time: 5
      MoveIt_Use_Cartesian_Path: false
      MoveIt_Use_Constraint_Aware_IK: true
      MoveIt_Workspace:
        Center: {X: 0, Y: 0, Z: 0.8}
        Size: {X: 3, Y: 3, Z: 2}
      Planned Path:
        Color Enabled: true
        Interrupt Display: false
        Loop Animation: true
        Robot Alpha: 0.5
        Robot Color: 150; 50; 150
        Show Robot Collision: false
        Show Robot Visual: true
        Show Trail: false
        State Display Time: REALTIME
        Trail Step Size: 1
        Trajectory Topic: /display_planned_path
        Use Sim Time: false
      Planning Metrics:
        Payload: 1
        Show Joint Torques: false
        Show Manipulability: false
        Show Manipulability Index: false
        Show Weight Limit: false
        TextHeight: 0.08
      Planning Request:
        Colliding Link Color: 255; 0; 0
        Goal State Alpha: 0.6
        Goal State Color: 250; 128; 0
        Interactive Marker Size: 0.2
        Joint Violation Color: 255; 0; 255
        Planning Group: right_arm
        Query Goal State: true
        Query Start State: false
        Show Workspace: false
        Start State Alpha: 1
        Start State Color: 0; 255; 0
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 0.9
        Scene Color: 50; 230; 50
        Scene Display Time: 0.01
        Show Scene Geometry: true
        Voxel Coloring: Z-Axis
        Voxel Rendering: Occupied Voxels
      Scene Robot:
        Attached Body Color: 150; 50; 150
        Robot Alpha: 1
        Show Robot Collision: false
        Show Robot Visual: true
      Velocity_Scaling_Factor: 0.5
      Acceleration_Scaling_Factor: 0.5
    # Goal of the last plan vs. current end effector (eef_goal_monitor.py).
    - Class: rviz_default_plugins/MarkerArray
      Name: EefGoalError
      Enabled: true
      Topic:
        Value: /aha/manipulation/eef_goal/markers
    - Class: rviz_default_plugins/MarkerArray
      Name: DetectedObjects
      Enabled: true
      Topic:
        Value: /aha/perception/objects/markers
    - Class: rviz_default_plugins/Image
      Name: HeadCamera
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: RightWristCamera
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /camera/right_wrist/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: base_footprint
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit
      Distance: 2.2
      Focal Point: {X: 0.3, Y: -0.2, Z: 0.6}
      Pitch: 0.45
      Yaw: 5.5

# Left: MotionPlanning above Displays. Right: head above right wrist camera.
# Bottom: the planned path's trajectory slider.
# QMainWindow State restores the docks by display / panel name. To change the
# layout or rename a display, arrange it in RViz and save (File > Save Config).
Window Geometry:
  Height: 1000
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: false
  Displays: {collapsed: false}
  MotionPlanning: {collapsed: false}
  HeadCamera: {collapsed: false}
  RightWristCamera: {collapsed: false}
  MotionPlanning - Trajectory Slider: {collapsed: false}
  QMainWindow State: 
