<?xml version="1.0"?>
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="scene_config" default="$(find aha_sim_tasks)/config/scene.json"/>
  <xacro:arg name="cameras" default="true"/>
  <xacro:arg name="ground_truth" default="false"/>
  <xacro:property name="scene" value="${xacro.load_yaml('$(arg scene_config)')}"/>
  <xacro:macro name="table" params="name position color">
    <model name="${name}">
      <static>true</static>
      <pose>${position[0]} ${position[1]} ${position[2]} 0 0 0</pose>
      <link name="top">
        <collision name="collision">
          <geometry><box><size>${scene.table_size[0]} ${scene.table_size[1]} ${scene.table_size[2]}</size></box></geometry>
          <surface><friction><ode><mu>${scene.physics.table_friction}</mu><mu2>${scene.physics.table_friction}</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>${scene.table_size[0]} ${scene.table_size[1]} ${scene.table_size[2]}</size></box></geometry>
          <material><ambient>${color} 1</ambient><diffuse>${color} 1</diffuse></material>
        </visual>
      </link>
      <xacro:property name="leg_height" value="${position[2] - scene.table_size[2]/2}"/>
      <xacro:macro name="leg" params="suffix x y">
        <link name="leg_${suffix}">
          <pose>${x} ${y} ${-scene.table_size[2]/2 - leg_height/2} 0 0 0</pose>
          <collision name="collision"><geometry><box><size>0.04 0.04 ${leg_height}</size></box></geometry></collision>
          <visual name="visual"><geometry><box><size>0.04 0.04 ${leg_height}</size></box></geometry>
            <material><ambient>0.18 0.16 0.14 1</ambient><diffuse>0.25 0.22 0.19 1</diffuse></material>
          </visual>
        </link>
      </xacro:macro>
      <xacro:leg suffix="front_left" x="${-scene.table_size[0]/2 + 0.04}" y="${scene.table_size[1]/2 - 0.04}"/>
      <xacro:leg suffix="front_right" x="${-scene.table_size[0]/2 + 0.04}" y="${-scene.table_size[1]/2 + 0.04}"/>
      <xacro:leg suffix="back_left" x="${scene.table_size[0]/2 - 0.04}" y="${scene.table_size[1]/2 - 0.04}"/>
      <xacro:leg suffix="back_right" x="${scene.table_size[0]/2 - 0.04}" y="${-scene.table_size[1]/2 + 0.04}"/>
    </model>
  </xacro:macro>
  <world name="task_tables">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <xacro:if value="$(arg cameras)">
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    </xacro:if>
    <plugin filename="aha_task_evaluation" name="aha_sim_tasks::EvaluationSystem">
      <ground_truth>$(arg ground_truth)</ground_truth>
      <robot_model>${scene.entities.robot_model}</robot_model>
      <object_model>${scene.entities.object_model}</object_model>
      <object_link>${scene.entities.object_link}</object_link>
      <object_collision>${scene.entities.object_collision}</object_collision>
      <right_finger_link>${scene.entities.right_finger_link}</right_finger_link>
      <left_finger_link>${scene.entities.left_finger_link}</left_finger_link>
      <destination_model>destination_table</destination_model>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>${scene.lighting.intensity} ${scene.lighting.intensity} ${scene.lighting.intensity} 1</diffuse>
      <direction>${scene.lighting.direction[0]} ${scene.lighting.direction[1]} ${scene.lighting.direction[2]}</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
      </visual>
    </link></model>
    <xacro:table name="source_table" position="${scene.source_table_position}" color="0.48 0.28 0.16"/>
    <xacro:table name="destination_table" position="${scene.destination_table_position}" color="0.10 0.55 0.16"/>
  </world>
</sdf>
