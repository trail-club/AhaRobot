  <description>Navigation (SLAM + Nav2) configs and launch for AhaRobot. Owner: navigation squad.</description>
  <maintainer email="dev@trail-club.local">trail-club navigation squad</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

