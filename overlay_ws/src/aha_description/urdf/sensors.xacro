<?xml version="1.0"?>
<!--
  Sensors for AhaRobot.

  Frames:
    link_head_tilt
      └── camera_link                    (fixed; D435i body center, x forward, z up at zero head joints)
            └── camera_color_optical_frame  (fixed; RGB optical center, REP-103 optical: z forward, x right, y down)

  Camera frames are always emitted because the real head RealSense (D435i)
  publishes in camera_color_optical_frame. The Gazebo sensor is emitted only
  when sim:=true.

  Gazebo topics (bridged to ROS by aha_perception/launch/perception.launch.py):
    head_camera/{image,depth_image,camera_info}  rgbd_camera, depth aligned to color
    {left,right}_wrist_camera/{image,camera_info}  RGB cameras
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- D435i body size; camera_link is the body center -->
  <xacro:property name="camera_body_x" value="0.02505"/>
  <xacro:property name="camera_body_y" value="0.09"/>
  <xacro:property name="camera_body_z" value="0.025"/>

  <!-- RGB optical center relative to camera_link (x forward, y left, z up).
       realsense-ros _d435.urdf.xacro: the depth origin is zero_depth_to_glass
       (4.2 mm) + glass_to_front (0.1 mm) behind the front face and 17.5 mm left
       of the body center; the color imager is 15 mm further left.
       => about 8.2 mm forward, 32.5 mm left. -->
  <xacro:property name="camera_color_xyz"
                  value="${camera_body_x/2 - 0.0042 - 0.0001} ${0.0175 + 0.015} 0"/>

  <!-- Head camera mount relative to link_head_tilt (origin on the tilt and pan axes).
       Design values of aha_perception/hardware/head_cam_mount_d435i:
       the camera back face is 40 mm (forward_offset) in front of the tilt axis,
       centered on the pan axis and at the tilt axis height, so the body center is
       40 + 25.05/2 = 52.525 mm forward.
       rpy compensates link_head_tilt's axes (+x forward, +y down, +z left). -->
  <xacro:property name="camera_back_offset" value="0.040"/>
  <xacro:property name="camera_mount_xyz" value="${camera_back_offset + camera_body_x/2} 0 0"/>
  <xacro:property name="camera_mount_rpy" value="${pi/2} 0 0"/>

  <!-- Head camera stream, matching tools/perception/macos/pointcloud/stream_realsense.py -->
  <xacro:property name="camera_width"  value="640"/>
  <xacro:property name="camera_height" value="480"/>
  <xacro:property name="camera_rate"   value="15"/>
  <!-- 55.9 deg: fx 602.9 px at 640x480, the real D435i color CameraInfo
       (tools/perception/plane_bench/real_frames, 2026-10-04). The 69 deg
       datasheet HFOV is for 16:9; 640x480 crops the sides. -->
  <xacro:property name="camera_hfov"   value="0.9759"/>

  <!-- Depth range; benchmark depth noise is applied by aha_sim_tasks to policy observations. -->
  <xacro:property name="camera_depth_near"         value="0.28"/>
  <xacro:property name="camera_depth_far"          value="10.0"/>
  <xacro:property name="camera_rgb_noise_stddev" value="$(arg camera_rgb_noise_stddev)"/>

  <!-- The Camera component (including its bracket) is already part of both
       upstream link_[lr]6.STL meshes. Use its CAD placement from
       Astra_Hardwares/Astra/Astra.STEP instead of adding another camera body.
       CAD link6 coordinates (X,Y,Z) map to wrist (60-Y, X, 28+Z), in mm.
       The Camera origin is (0,34,73) mm, and its lens looks 30 degrees down
       from wrist +z. Wrist +x points DOWN with the arm extended, so this
       placement is above the grasp center (0.063, 0, 0.195).
       The lens front is 16 mm along the camera's viewing axis. These are CAD
       design values; optical calibration on the real robot is not available. -->
  <xacro:property name="wrist_camera_mount_xyz" value="0.026 0 0.101"/>
  <xacro:property name="wrist_camera_mount_pitch" value="${-pi/3}"/>
  <xacro:property name="wrist_camera_lens_offset" value="0.016"/>

  <xacro:macro name="aha_wrist_camera" params="side parent">
    <link name="${side}_wrist_camera_link"/>
    <joint name="${side}_wrist_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${side}_wrist_camera_link"/>
      <origin xyz="${wrist_camera_mount_xyz}" rpy="0 ${wrist_camera_mount_pitch} 0"/>
    </joint>
    <link name="${side}_wrist_camera_optical_frame"/>
    <joint name="${side}_wrist_camera_optical_joint" type="fixed">
      <parent link="${side}_wrist_camera_link"/>
      <child link="${side}_wrist_camera_optical_frame"/>
      <origin xyz="${wrist_camera_lens_offset} 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <gazebo reference="${side}_wrist_camera_link">
      <sensor name="${side}_wrist_camera" type="camera">
        <pose>${wrist_camera_lens_offset} 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${camera_rate}</update_rate>
        <visualize>false</visualize>
        <topic>${side}_wrist_camera/image</topic>
        <gz_frame_id>${side}_wrist_camera_optical_frame</gz_frame_id>
        <camera>
          <camera_info_topic>${side}_wrist_camera/camera_info</camera_info_topic>
          <horizontal_fov>${pi/2}</horizontal_fov>
          <image>
            <width>${camera_width}</width>
            <height>${camera_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.02</near><far>3.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>${camera_rgb_noise_stddev}</stddev></noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="aha_sensors" params="sim cameras:=true">

    <link name="camera_link">
      <visual>
        <geometry><box size="${camera_body_x} ${camera_body_y} ${camera_body_z}"/></geometry>
        <material name="camera_dark_grey"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="link_head_tilt"/>
      <child  link="camera_link"/>
      <origin xyz="${camera_mount_xyz}" rpy="${camera_mount_rpy}"/>
    </joint>

    <link name="camera_color_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child  link="camera_color_optical_frame"/>
      <origin xyz="${camera_color_xyz}" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <xacro:if value="${sim}">
      <xacro:if value="${cameras}">
      <gazebo reference="camera_link">
        <sensor name="head_camera" type="rgbd_camera">
          <!-- Same offset as camera_optical_joint so the image origin is camera_color_optical_frame -->
          <pose>${camera_color_xyz} 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>${camera_rate}</update_rate>
          <visualize>false</visualize>
          <topic>head_camera</topic>
          <gz_frame_id>camera_color_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>${camera_hfov}</horizontal_fov>
            <image>
              <width>${camera_width}</width>
              <height>${camera_height}</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
            <depth_camera>
              <clip>
                <near>${camera_depth_near}</near>
                <far>${camera_depth_far}</far>
              </clip>
            </depth_camera>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${camera_rgb_noise_stddev}</stddev>
            </noise>
          </camera>
        </sensor>
      </gazebo>
      <xacro:aha_wrist_camera side="left" parent="link_l6"/>
      <xacro:aha_wrist_camera side="right" parent="link_r6"/>
      </xacro:if>
    </xacro:if>

  </xacro:macro>

</robot>
