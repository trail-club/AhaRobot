<?xml version="1.0"?>
<!--
  Differential-drive base added under the existing base_link mesh.

  Provisional dimensions (base is 550x500 mm / ~51 kg per the AhaRobot paper);
  refine once real chassis / wheel specs are confirmed:

    wheel_radius     = 0.075 m
    wheel_separation = 0.40  m
    caster_radius    = 0.03  m

  Frames:
    base_footprint   — flat frame on the ground plane (Nav2 default root)
      └── base_link  — original mesh; lifted by wheel_radius so wheels touch ground
            ├── left_wheel_link   (continuous joint: left_wheel_joint)
            ├── right_wheel_link  (continuous joint: right_wheel_joint)
            └── caster_link       (fixed joint; sphere collision, low friction)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius"     value="0.075"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_separation" value="0.40"/>
  <xacro:property name="wheel_mass"       value="0.5"/>
  <xacro:property name="caster_radius"    value="0.03"/>
  <xacro:property name="caster_xoffset"   value="-0.18"/>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(1.0/12.0)*m*(3*r*r + h*h)}" ixy="0" ixz="0"
        iyy="${(1.0/12.0)*m*(3*r*r + h*h)}" iyz="0"
        izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sph_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${0.4*m*r*r}" ixy="0" ixz="0"
        iyy="${0.4*m*r*r}" iyz="0"
        izz="${0.4*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="aha_mobile_base" params="parent">
    <!-- Root frame at ground level -->
    <link name="base_footprint"/>

    <!-- Lift existing base_link so wheel bottoms touch z=0 -->
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child  link="${parent}"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- Wheels -->
    <xacro:macro name="drive_wheel" params="prefix y_sign">
      <link name="${prefix}_wheel_link">
        <visual>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </link>

      <joint name="${prefix}_wheel_joint" type="continuous">
        <parent link="${parent}"/>
        <child  link="${prefix}_wheel_link"/>
        <origin xyz="0 ${y_sign * wheel_separation/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="10.0" velocity="10.0"/>
        <dynamics damping="0.01" friction="0.01"/>
      </joint>

      <gazebo reference="${prefix}_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
      </gazebo>
    </xacro:macro>

    <xacro:drive_wheel prefix="left"  y_sign="1"/>
    <xacro:drive_wheel prefix="right" y_sign="-1"/>

    <!-- Passive caster (fixed sphere; low friction) -->
    <link name="caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sph_inertia m="0.1" r="${caster_radius}"/>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="caster_link"/>
      <origin xyz="${caster_xoffset} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

</robot>
