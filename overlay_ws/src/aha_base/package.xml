<?xml version="1.0"?>
<package format="3">
  <name>aha_base</name>
  <version>0.1.0</version>
  <description>
    Real differential-drive base: ODrive v3.6 over USB with the same topics as
    the simulation's diff_drive_controller.
  </description>
  <maintainer email="dev@trail-club.local">trail-club</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- odrive==0.5.4 (pip, without its dependencies) and libusb-1.0: see README.md -->

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
