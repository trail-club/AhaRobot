<?xml version="1.0"?>
<package format="3">
  <name>aha_perception</name>
  <version>0.1.0</version>
  <description>Camera point cloud, RViz views (real camera and simulation) and perception interfaces for AhaRobot.</description>
  <maintainer email="dev@trail-club.local">trail-club perception squad</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <!-- RViz panel used by rviz/sim_view.rviz -->
  <exec_depend>slam_toolbox</exec_depend>
  <!-- perception.launch.py: Gazebo head camera bridge -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- real_head_camera.launch.py -->
  <exec_depend>aha_description</exec_depend>
  <exec_depend>aha_servo</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
