<?xml version="1.0"?>
<package format="3">
  <name>aha_perception</name>
  <version>0.1.0</version>
  <description>Camera-only RViz view and perception interfaces for AhaRobot.</description>
  <maintainer email="dev@trail-club.local">trail-club perception squad</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
