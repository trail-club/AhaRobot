    {"id": "plan.generate", "group": "計画", "title": "命令を手順へ分解し計画を示す", "skill": "plan_commands", "params": {"commands": ["command1.text", "command2.text", "command3.text"]}, "points": 300, "mock": {"plan": [{"command": 1, "action": "navigate", "params": {"location": "kitchen_table"}}, {"command": 1, "action": "pick_object", "params": {"object": "cola", "surface": "kitchen_table"}, "mock": {"robot.holding": "cola"}}, {"command": 3, "action": "navigate", "params": {"location": "bedroom"}}, {"command": 3, "action": "find_described_person", "params": {"name": "Jules", "location": "bedroom"}}, {"command": 3, "action": "answer_question", "params": {"question": "the time"}}, {"command": 1, "action": "navigate", "params": {"location": "office"}}, {"command": 1, "action": "find_described_person", "params": {"gesture": "waving person", "location": "office"}}, {"command": 1, "action": "deliver_object", "params": {"object": "cola", "person": "waving person"}, "mock": {"robot.holding": null}}, {"command": 2, "action": "navigate", "params": {"location": "desk"}}, {"command": 2, "action": "count", "params": {"target": "drinks", "location": "desk", "output": "command2.count"}, "mock": {"command2.count": 3}}, {"command": 2, "action": "navigate", "params": {"location": "instruction_point"}}, {"command": 2, "action": "tell_info", "params": {"key": "command2.count", "person": "operator"}}]}, "note": "3×100。発話や画面で計画を示す"},

