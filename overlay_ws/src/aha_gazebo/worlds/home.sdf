<?xml version="1.0"?>
<!--
  Simple @Home-style world for AhaRobot.
  - 6 x 5 m room with 4 walls (0.1 m thick, 2.5 m tall)
  - kitchen counter (long table) on the +Y wall
  - dining table + 2 chairs in the middle
  - a few graspable objects on the counter (bottle, can, box)

  All primitive geometry — no external meshes needed.
  Spawn robot at origin (0,0,~0.05) with sim.launch.py default.
-->
<sdf version="1.10">
  <world name="home">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor (wooden look). Room is 6m (x) x 5m (y), centered at origin. -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>6 5</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>6 5</size></plane></geometry>
          <material>
            <ambient>0.60 0.45 0.30 1</ambient>
            <diffuse>0.70 0.55 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls: 0.1 m thick, 2.5 m tall.  -->
    <!-- North wall (+Y = 2.5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.1 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <!-- South wall (-Y = -2.5) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.1 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <!-- East wall (+X = 3.0) -->
    <model name="wall_east">
      <static>true</static>
      <pose>3.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <!-- West wall (-X = -3.0) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5 2.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Kitchen counter along north wall: 3 m long, 0.6 m deep, 0.9 m tall -->
    <model name="kitchen_counter">
      <static>true</static>
      <pose>0 2.15 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.6 0.9</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dining table: 1.2 x 0.8 x 0.75 m, centered -->
    <model name="dining_table">
      <static>true</static>
      <pose>0 -0.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.8 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 0.75</size></box></geometry>
          <material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Two chairs (simple boxes as placeholder) -->
    <model name="chair_1">
      <static>true</static>
      <pose>-0.9 -0.5 0.23 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.45</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="chair_2">
      <static>true</static>
      <pose>0.9 -0.5 0.23 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.45</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Graspable objects on kitchen counter. Non-static so pick can lift them. -->
    <model name="bottle">
      <pose>-0.8 2.1 1.0 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.0005</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.2 1</ambient><diffuse>0.15 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="can">
      <pose>-0.3 2.1 0.96 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.5 0.05 0.05 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cereal_box">
      <pose>0.5 2.1 1.05 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.4</mass>
          <inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.15 0.06 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 0.06 0.3</size></box></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.95 0.75 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
