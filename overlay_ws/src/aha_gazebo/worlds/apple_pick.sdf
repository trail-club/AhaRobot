<?xml version="1.0"?>
<!-- A small pick demo: the robot must drive forward to reach the apple. -->
<sdf version="1.10">
  <world name="apple_pick">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Place the apple at the gripper pose reached by the forward approach. -->
    <model name="side_table">
      <static>true</static>
      <pose>0.962 -0.426 0 0 0 0</pose>
      <link name="top">
        <collision name="collision">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry><box><size>0.24 0.28 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry><box><size>0.24 0.28 0.04</size></box></geometry>
          <material>
            <ambient>0.38 0.22 0.12 1</ambient>
            <diffuse>0.48 0.28 0.16 1</diffuse>
          </material>
        </visual>
        <collision name="front_left">
          <pose>-0.09 0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
        </collision>
        <collision name="front_right">
          <pose>0.09 0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
        </collision>
        <collision name="rear_left">
          <pose>-0.09 -0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
        </collision>
        <collision name="rear_right">
          <pose>0.09 -0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
        </collision>
        <visual name="front_left_visual">
          <pose>-0.09 0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material>
            <ambient>0.38 0.22 0.12 1</ambient>
            <diffuse>0.48 0.28 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="front_right_visual">
          <pose>0.09 0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material>
            <ambient>0.38 0.22 0.12 1</ambient>
            <diffuse>0.48 0.28 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="rear_left_visual">
          <pose>-0.09 -0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material>
            <ambient>0.38 0.22 0.12 1</ambient>
            <diffuse>0.48 0.28 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="rear_right_visual">
          <pose>0.09 -0.11 0.04 0 0 0</pose>
          <geometry><box><size>0.03 0.03 0.08</size></box></geometry>
          <material>
            <ambient>0.38 0.22 0.12 1</ambient>
            <diffuse>0.48 0.28 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- This is at the right gripper after the forward approach. -->
    <model name="apple">
      <pose>0.962 -0.4260 0.160 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>true</publish_link_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0000512</ixx><iyy>0.0000512</iyy><izz>0.0000512</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="fruit_collision">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="fruit_visual">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material>
            <ambient>0.65 0.03 0.02 1</ambient>
            <diffuse>0.90 0.04 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="stem">
          <pose>0 0 0.038 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.025</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.28 0.04 1</ambient>
            <diffuse>0.18 0.42 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
