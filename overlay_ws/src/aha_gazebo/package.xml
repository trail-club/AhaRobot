<?xml version="1.0"?>
<package format="3">
  <name>aha_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic worlds and spawn launch for AhaRobot.</description>
  <maintainer email="dev@trail-club.local">trail-club</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>aha_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>sobits_gazebo_worlds</exec_depend>
  <exec_depend>tmc_wrs_gz_worlds</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
