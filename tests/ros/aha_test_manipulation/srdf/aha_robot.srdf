<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of AhaRobot for MoveIt 2.
  No virtual joint: the planning frame is the URDF root base_footprint.
-->
<robot name="aha_robot">

  <!-- Arm chains include the lift (joint_[l|r]1) and end at the fingertip TCP. -->
  <group name="right_arm">
    <chain base_link="base_link" tip_link="link_ree"/>
  </group>
  <group name="left_arm">
    <chain base_link="base_link" tip_link="link_lee"/>
  </group>
  <group name="right_hand">
    <joint name="joint_r7r"/>
    <joint name="joint_r7l"/>
  </group>
  <group name="left_hand">
    <joint name="joint_l7r"/>
    <joint name="joint_l7l"/>
  </group>

  <!--
    home: spawn pose (arm joints zero, lift 1 cm above its stop).
    ready: lift raised, forearm forward, TCP x forward.
    carry: lift at 0.8 m, elbow folded back; TCP x forward at (0.22, -/+0.30, 0.92)
           in base_footprint, in front of tables and shelves the base stops at.
  -->
  <group_state name="home" group="right_arm">
    <joint name="joint_r1" value="0.01"/>
    <joint name="joint_r2" value="0"/>
    <joint name="joint_r3" value="0"/>
    <joint name="joint_r4" value="0"/>
    <joint name="joint_r5" value="0"/>
    <joint name="joint_r6" value="0"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="joint_r1" value="0.6"/>
    <joint name="joint_r2" value="0.8"/>
    <joint name="joint_r3" value="-0.8"/>
    <joint name="joint_r4" value="0"/>
    <joint name="joint_r5" value="0"/>
    <joint name="joint_r6" value="0"/>
  </group_state>
  <group_state name="carry" group="right_arm">
    <joint name="joint_r1" value="0.8"/>
    <joint name="joint_r2" value="-0.887"/>
    <joint name="joint_r3" value="1.118"/>
    <joint name="joint_r4" value="0.231"/>
    <joint name="joint_r5" value="0"/>
    <joint name="joint_r6" value="0"/>
  </group_state>
  <group_state name="home" group="left_arm">
    <joint name="joint_l1" value="0.01"/>
    <joint name="joint_l2" value="0"/>
    <joint name="joint_l3" value="0"/>
    <joint name="joint_l4" value="0"/>
    <joint name="joint_l5" value="0"/>
    <joint name="joint_l6" value="0"/>
  </group_state>
  <group_state name="ready" group="left_arm">
    <joint name="joint_l1" value="0.6"/>
    <joint name="joint_l2" value="-0.8"/>
    <joint name="joint_l3" value="0.8"/>
    <joint name="joint_l4" value="0"/>
    <joint name="joint_l5" value="0"/>
    <joint name="joint_l6" value="0"/>
  </group_state>
  <group_state name="carry" group="left_arm">
    <joint name="joint_l1" value="0.8"/>
    <joint name="joint_l2" value="0.887"/>
    <joint name="joint_l3" value="-1.118"/>
    <joint name="joint_l4" value="-0.231"/>
    <joint name="joint_l5" value="0"/>
    <joint name="joint_l6" value="0"/>
  </group_state>
  <group_state name="open" group="right_hand">
    <joint name="joint_r7r" value="0.06"/>
    <joint name="joint_r7l" value="-0.06"/>
  </group_state>
  <group_state name="closed" group="right_hand">
    <joint name="joint_r7r" value="0"/>
    <joint name="joint_r7l" value="0"/>
  </group_state>
  <group_state name="open" group="left_hand">
    <joint name="joint_l7r" value="0.06"/>
    <joint name="joint_l7l" value="-0.06"/>
  </group_state>
  <group_state name="closed" group="left_hand">
    <joint name="joint_l7r" value="0"/>
    <joint name="joint_l7l" value="0"/>
  </group_state>

  <end_effector name="right_gripper" parent_link="link_ree" group="right_hand" parent_group="right_arm"/>
  <end_effector name="left_gripper" parent_link="link_lee" group="left_hand" parent_group="left_arm"/>

  <!-- Teleop markers carry a zero-size placeholder cylinder. -->
  <disable_default_collisions link="link_ree_teleop"/>
  <disable_default_collisions link="link_lee_teleop"/>

  <!--
    Generated by moveit_setup_assistant/collisions_updater (300000 samples, sim:=true URDF).
    Removed by review: head (link_head_pan / link_head_tilt) vs arm-link pairs, kept checked.
  -->
  <disable_collisions link1="base_link" link2="caster_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_head_pan" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_head_tilt" reason="Never"/>
  <disable_collisions link1="base_link" link2="link_l1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_r1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="caster_link" link2="left_wheel_link" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_head_pan" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_head_tilt" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l1" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l2" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l3" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l4" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l5" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l6" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l7l" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_l7r" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r1" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r2" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r3" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r4" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r5" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r6" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r7l" reason="Never"/>
  <disable_collisions link1="caster_link" link2="link_r7r" reason="Never"/>
  <disable_collisions link1="caster_link" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_head_pan" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_head_tilt" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_l1" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_l2" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_l3" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_l4" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_l5" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_r1" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_r2" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_r3" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_r4" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="link_r5" reason="Never"/>
  <disable_collisions link1="left_wheel_link" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_head_pan" link2="link_head_tilt" reason="Adjacent"/>
  <disable_collisions link1="link_head_pan" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_head_tilt" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l1" link2="link_l2" reason="Adjacent"/>
  <disable_collisions link1="link_l1" link2="link_r1" reason="Never"/>
  <disable_collisions link1="link_l1" link2="link_r2" reason="Never"/>
  <disable_collisions link1="link_l1" link2="link_r3" reason="Never"/>
  <disable_collisions link1="link_l1" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l2" link2="link_l3" reason="Adjacent"/>
  <disable_collisions link1="link_l2" link2="link_r1" reason="Never"/>
  <disable_collisions link1="link_l2" link2="link_r2" reason="Never"/>
  <disable_collisions link1="link_l2" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l3" link2="link_l4" reason="Adjacent"/>
  <disable_collisions link1="link_l3" link2="link_l5" reason="Never"/>
  <disable_collisions link1="link_l3" link2="link_r1" reason="Never"/>
  <disable_collisions link1="link_l3" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l4" link2="link_l5" reason="Adjacent"/>
  <disable_collisions link1="link_l4" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l5" link2="link_l6" reason="Adjacent"/>
  <disable_collisions link1="link_l5" link2="link_l7l" reason="Never"/>
  <disable_collisions link1="link_l5" link2="link_l7r" reason="Never"/>
  <disable_collisions link1="link_l5" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l6" link2="link_l7l" reason="Adjacent"/>
  <disable_collisions link1="link_l6" link2="link_l7r" reason="Adjacent"/>
  <disable_collisions link1="link_l6" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_l7l" link2="link_l7r" reason="Never"/>
  <disable_collisions link1="link_r1" link2="link_r2" reason="Adjacent"/>
  <disable_collisions link1="link_r1" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_r2" link2="link_r3" reason="Adjacent"/>
  <disable_collisions link1="link_r2" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_r3" link2="link_r4" reason="Adjacent"/>
  <disable_collisions link1="link_r3" link2="link_r5" reason="Never"/>
  <disable_collisions link1="link_r3" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_r4" link2="link_r5" reason="Adjacent"/>
  <disable_collisions link1="link_r4" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_r5" link2="link_r6" reason="Adjacent"/>
  <disable_collisions link1="link_r5" link2="link_r7l" reason="Never"/>
  <disable_collisions link1="link_r5" link2="link_r7r" reason="Never"/>
  <disable_collisions link1="link_r5" link2="right_wheel_link" reason="Never"/>
  <disable_collisions link1="link_r6" link2="link_r7l" reason="Adjacent"/>
  <disable_collisions link1="link_r6" link2="link_r7r" reason="Adjacent"/>
  <disable_collisions link1="link_r7l" link2="link_r7r" reason="Never"/>

</robot>
