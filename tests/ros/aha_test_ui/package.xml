<?xml version="1.0"?>
<package format="3">
  <name>aha_test_ui</name>
  <version>0.1.0</version>
  <description>Robot monitor: module states, LLM conversations and events published as JSON, and a Qt window showing them.</description>
  <maintainer email="dev@trail-club.local">trail-club</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
